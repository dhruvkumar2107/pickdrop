# Copy this file to .env before building/running the Flutter app.
# Only client-visible, restricted/public keys belong here. Never add server secrets.
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Restrict this key by Android package/SHA-1 and enabled APIs in Google Cloud.
GOOGLE_MAPS_API_KEY=your_restricted_maps_key_here

# Razorpay Key ID is public. RAZORPAY_KEY_SECRET belongs only in Functions secrets.
RAZORPAY_KEY_ID=rzp_test_replace_me
FUNCTIONS_REGION=us-central1
TRACKING_BASE_URL=https://your-project-id.web.app
PHONE_AUTH_MODE=firebase
USE_FIREBASE_EMULATORS=false
# Host for the Firebase Emulator Suite when USE_FIREBASE_EMULATORS=true.
# Android emulators must use 10.0.2.2; desktop/iOS/web use localhost.
EMULATOR_HOST=localhost
# Optional: where web/legal/terms.html and privacy.html are hosted (defaults to TRACKING_BASE_URL/legal).
LEGAL_BASE_URL=
