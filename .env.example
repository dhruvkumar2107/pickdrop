# Firebase Configuration
# Get these from Firebase Console > Project Settings > General > Your apps
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Google Maps API Key
# Get from Google Cloud Console > APIs & Services > Credentials
# Enable: Maps SDK for Android, Places API, Directions API, Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay Configuration
# Get from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloud Functions Region (optional, defaults to us-central1)
FUNCTIONS_REGION=us-central1

# Public web tracking base URL used in WhatsApp share links
# (Firebase Hosting: https://<project-id>.web.app)
TRACKING_BASE_URL=https://your-project-id.web.app

# Login mode: "any" accepts any 10-digit number + any OTP (no SMS),
# "firebase" uses real Firebase phone verification.
PHONE_AUTH_MODE=any