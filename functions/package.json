{
  "name": "pickdrop-functions",
  "description": "PickDrop Cloud Functions — fare, matching, OTP, cancellation, payments",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/test/*.test.js\"",
    "test:rules": "node --test \"test/rules/*.test.js\"",
    "watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "grant-admin": "node scripts/grant-admin-claim.cjs",
    "seed": "node ../scripts/seed.js"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "typescript": "^5.6.0"
  }
}
