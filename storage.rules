rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Driver documents: KYC uploads (Aadhaar, license, RC, photo).
    // Each driver may only write inside their own folder.
    match /drivers/{uid}/{fileName} {
      allow read: if signedIn()
        && (request.auth.uid == uid || request.auth.token.role == 'admin');
      allow write: if isOwner(uid) && isImage();
      allow delete: if isOwner(uid);
    }

    // User avatars
    match /users/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && isImage();
      allow delete: if isOwner(uid);
    }

    // Goods photos taken by the assigned driver at pickup and drop.
    match /bookingProofs/{bookingId}/{fileName} {
      function trip() {
        return firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data;
      }
      allow read: if signedIn()
        && (request.auth.uid == trip().customerId
          || request.auth.uid == trip().driverId
          || request.auth.token.role == 'admin');
      allow create, update: if signedIn()
        && fileName in ['pickup.jpg', 'drop.jpg']
        && request.auth.uid == trip().driverId
        && trip().status in ['DRIVER_ASSIGNED', 'PICKED_UP']
        && isImage();
      allow delete: if false;
    }

    // Everything else is not accessible from clients.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
