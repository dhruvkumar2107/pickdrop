rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function participant(data) {
      return signedIn() &&
        (data.customerId == request.auth.uid || data.driverId == request.auth.uid);
    }

    match /users/{uid} {
      allow read: if owner(uid) || isAdmin();
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'customer';
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'photoUrl', 'emergencyContact', 'fcmToken', 'updatedAt', 'phoneNumber', 'role'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || request.resource.data.role in ['customer', 'driver', 'both']);
      allow delete: if false;
    }

    match /drivers/{uid} {
      function assignedCustomer() {
        return signedIn()
          && resource.data.activeBookingId is string
          && exists(/databases/$(database)/documents/bookings/$(resource.data.activeBookingId))
          && get(/databases/$(database)/documents/bookings/$(resource.data.activeBookingId)).data.driverId == uid
          && get(/databases/$(database)/documents/bookings/$(resource.data.activeBookingId)).data.customerId == request.auth.uid;
      }
      allow read: if owner(uid) || assignedCustomer() || isAdmin();
      allow create: if false;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isOnline', 'currentLocation', 'currentLat', 'currentLng', 'geohash', 'fcmToken', 'updatedAt']);
      allow delete: if false;
    }

    match /driverPrivate/{uid} {
      allow read: if owner(uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /savedAddresses/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    match /bookings/{id} {
      allow read: if participant(resource.data) || isAdmin();
      allow write: if false;
      match /chatMessages/{messageId} {
        function trip() {
          return get(/databases/$(database)/documents/bookings/$(id)).data;
        }
        function isParticipant() {
          return signedIn() && (trip().customerId == request.auth.uid || trip().driverId == request.auth.uid);
        }
        allow read: if isParticipant();
        allow create: if isParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == (trip().customerId == request.auth.uid ? 'customer' : 'driver')
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }
    match /bookingSecrets/{id} {
      allow read: if signedIn() && resource.data.customerId == request.auth.uid || isAdmin();
      allow write: if false;
    }
    match /payments/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /driverOffers/{id} {
      allow read: if signedIn() && resource.data.driverId == request.auth.uid;
      allow write: if false;
    }
    match /scheduledBookings/{id} {
      allow read: if signedIn() && resource.data.customerId == request.auth.uid;
      allow write: if false;
    }
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'isRead']);
      allow create, delete: if false;
    }

    match /vehicleTypes/{id} { allow read: if signedIn(); allow write: if false; }
    match /coupons/{id} { allow read: if signedIn(); allow write: if false; }
    match /config/{id} { allow read: if signedIn(); allow write: if false; }
    match /driverScores/{id} { allow read: if owner(id) || isAdmin(); allow write: if false; }
    match /driverLedger/{id} {
      allow read: if signedIn() && resource.data.driverId == request.auth.uid;
      allow write: if false;
    }
    match /wallets/{uid} { allow read: if owner(uid) || isAdmin(); allow write: if false; }
    match /ratings/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /reports/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }
    match /tripProofs/{id} {
      allow read: if participant(resource.data) || isAdmin();
      allow write: if false;
    }
    match /supportTickets/{id} {
      allow read: if (signedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      // Created and answered only through createSupportTicket / respondToSupportTicket.
      allow create, update, delete: if false;
    }
    match /safetyContacts/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 24
        && request.resource.data.keys().hasOnly(['userId', 'name', 'phone', 'createdAt']);
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /sosAlerts/{id} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create, update, delete: if false;
    }
    match /driverPayouts/{id} {
      allow read: if (signedIn() && resource.data.driverId == request.auth.uid) || isAdmin();
      allow write: if false;
    }
    match /walletTransactions/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /walletTopupOrders/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /referrals/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // All unlisted collections are private and server-managed by default.
    match /{collection}/{id} { allow read, write: if false; }
  }
}
