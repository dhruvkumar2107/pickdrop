<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/pickdrop_widget_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PickDrop"
        android:textColor="#FF6B00"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Your driver is on the way"
        android:textColor="#C6C9CF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_fare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#8B9099"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/pickdrop_widget_button"
        android:gravity="center"
        android:text="Book a PickDrop"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
